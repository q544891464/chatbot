# OpenAPI application credentials. Keep the real file at scripts/address-book-sync.env.
ADDRESS_BOOK_CLIENT_ID=replace-with-openapi-client-id
ADDRESS_BOOK_CLIENT_SECRET=replace-with-openapi-client-secret

# The API host must use HTTPS because the address book responses are encrypted.
ADDRESS_BOOK_OPENAPI_BASE_URL=https://imtwo.zdxlz.com
ADDRESS_BOOK_TOKEN_PATH=/open-apis/v1/auth/token
ADDRESS_BOOK_SCOPE=open
ADDRESS_BOOK_DEPARTMENT_CHILDREN_PATH=/open/v2/dept/children
ADDRESS_BOOK_DEPARTMENT_USERS_PATH=/open/v2/dept/users/list
ADDRESS_BOOK_ROOT_DEPARTMENT_ID=1
ADDRESS_BOOK_ROOT_DEPARTMENT_NAME=root

# Refuse suspiciously small responses, retaining the prior JSON and database data.
ADDRESS_BOOK_MIN_DEPARTMENT_COUNT=2
ADDRESS_BOOK_MIN_USER_COUNT=1
ADDRESS_BOOK_REQUEST_TIMEOUT_MS=30000
ADDRESS_BOOK_REQUEST_ATTEMPTS=3
ADDRESS_BOOK_IMPORT_ENABLED=true
