[Unit]
Description=Chatbot H5 Proxy Service
After=network.target docker.service
Wants=network.target
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/chatbot/chatbot
ExecStart=/root/chatbot/chatbot/server/start.sh
Restart=always
RestartSec=3
Environment=PATH=/root/.nvm/versions/node/v22.12.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
